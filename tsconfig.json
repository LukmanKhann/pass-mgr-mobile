{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "moduleResolution": "bundler",
    "paths": {
      "@components/*": [
        "./src/components/*"
      ],
      "@screens/*": [
        "./src/screens/*"
      ],
      "@hooks/*": [
        "./src/hooks/*"
      ],
      "@theme/*": [
        "./src/theme/*"
      ],
      "@navigation/*": [
        "./src/navigation/*"
      ],
      "@context/*": [
        "./src/context/*"
      ],
      "@global/*": [
        "./src/global/*"
      ],
      "@motion/*": [
        "./src/motion/*"
      ]
    },
    "resolveJsonModule": true
  }
}