# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Resolve the Firebase iOS SDK with CocoaPods instead of Swift Package Manager.
# react-native-firebase v26 uses SPM by default on React Native >= 0.75, but
# firebase-ios-sdk's SPM products are automatic (static) libraries, which are
# incompatible with static pod linkage (duplicate-symbol link errors).
# CocoaPods mode supports static or dynamic linkage. See https://rnfirebase.io/ios-spm
$RNFirebaseDisableSPM = true

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Build every pod as a static framework, which gives each pod its own embedded module
# map. This is required for Firebase 12+, whose Swift pods (FirebaseAuth,
# FirebaseCoreInternal, FirebaseDatabase, FirebaseFirestore) must `import` their
# Objective-C dependencies:
#   - As plain static libraries those deps lack module maps:
#       "[!] The Swift pod `X` depends upon `Y`, which does not define modules."
#   - `use_modular_headers!` instead generates a broken module map for gRPC-Core
#     (gRPC-Core/gRPC-C++ share the `grpc` header dir, so CocoaPods never materializes
#     Pods/Headers/Private/grpc/gRPC-Core.modulemap):
#       "module map file '.../gRPC-Core.modulemap' not found"
#   Static frameworks avoid both problems. See rnfirebase.io/ios-spm and
#   github.com/invertase/react-native-firebase/issues/7805.
$RNFirebaseAsStaticFramework = true

# Default to static linkage (matches RN's USE_FRAMEWORKS knob while keeping the
# community-standard static-framework setup for Firebase).
linkage = ENV['USE_FRAMEWORKS'] || 'static'
use_frameworks! :linkage => linkage.to_sym

target 'passMgrMobile' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  pod 'NitroModules', :path => '../node_modules/react-native-nitro-modules'

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )
  end
end
